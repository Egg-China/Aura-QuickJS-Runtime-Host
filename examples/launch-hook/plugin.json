{
  "schemaVersion": 5,
  "id": "dev.hmclce.example.javascript.launch-hook",
  "name": "Aura JavaScript Game Launch Hook Plugin",
  "version": "1.0.0",
  "description": "Isolated JavaScript example that observes launch Hooks and FileUtils.getName after Patches.",
  "author": "Aura Launcher Community",
  "type": "java",
  "runtime": "javascript",
  "abi": 1,
  "platforms": ["windows-x64", "windows-arm64", "linux-x64", "linux-arm64", "macos-x64", "macos-arm64"],
  "entrypoint": "aura-javascript.json",
  "executionMode": "isolated",
  "runtimeProvider": "dev.hmclce.runtime.quickjs-host",
  "dependencies": [],
  "permissions": ["launcher-hook", "launcher-patch"],
  "requiredPermissions": ["launcher-hook", "launcher-patch"],
  "hooks": ["before-game-launch"],
  "patches": [{
    "target": "org.jackhuang.hmcl.util.io.FileUtils",
    "method": "getName",
    "type": "after",
    "parameters": ["java.nio.file.Path"]
  }],
  "launcherVersion": ">=27.1-0-next"
}
